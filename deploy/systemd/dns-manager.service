[Unit]
Description=dns_manager - BIND 9 zone editor
Documentation=file:///opt/dns-manager/docs/blueprint/plan.md
After=network-online.target named.service
Wants=named.service

[Service]
Type=exec
# (선택) 이 유닛은 설치 스크립트가 등록하지 않는다. systemd 로 돌리고 싶을 때만 쓴다.
# root 로 실행한다 — BIND 가 쓰는 계정·그룹이 서버마다 달라 권한을 맞추려 들면
# 서버마다 다른 문제가 생긴다.
User=root
WorkingDirectory=/opt/dns-manager
Environment=DNS_MANAGER_CONFIG=/etc/dns-manager/config.toml
# 작업 디렉터리를 sys.path 에 넣지 않는다. 설치 경로에 같은 이름의 디렉터리가 남아 있으면
# 설치된 패키지를 가려 조용히 옛 코드가 돌아간다(실제로 겪은 문제).
Environment=PYTHONSAFEPATH=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/dns-manager/.venv/bin/python -m dns_manager
Restart=on-failure
RestartSec=3

# 쓰기 허용 경로를 명시적으로 한정한다
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/named /etc/named /var/lib/dns-manager
StateDirectory=dns-manager
# 0.0.0.0 수신이므로 주소 제한을 걸지 않는다. 접근 통제는 방화벽/프록시 담당.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# 상시 구동하지 않는다. 필요할 때 systemctl start 로 띄운다.
# (enable 로 자동 시작을 걸지 않는 것을 전제로 한다)
[Install]
WantedBy=multi-user.target
